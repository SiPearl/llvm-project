// CHECK:  %[[BW_NOERRMSG:.*]] = fir.convert %{{.*}} : (!fir.box<none>) -> !fir.box<!fir.char<1,?>>
// CHECK:  fir.call @_QMprifPprif_allocate(%[[BW_SIZE:.*]], %[[BW_PTR:.*]], %[[BW_NOSTAT]], %[[BW_NOERRMSG]], %[[BW_NOERRMSG_ALLOC]]) : (!fir.ref<i64>, !fir.ref<!fir.type<_QM__fortran_builtinsT__builtin_c_ptr{__address:i64}>>, !fir.ref<i32>, !fir.box<!fir.char<1,?>>, !fir.box<!fir.char<1,?>>) -> ()
// CHECK:  %[[BW_ADDR_REF:.*]] = fir.coordinate_of %[[BW_PTR]], __address
// CHECK:  %[[BW_ADDR:.*]] = fir.load %[[BW_ADDR_REF]] : !fir.ref<i64>
// CHECK:  %[[BW_BASE_REF:.*]] = fir.convert %[[BW]] : {{.*}} -> !fir.ref<!fir.box<none>>
// CHECK:  %[[BW_BASE:.*]] = fir.convert %[[BW_ADDR]] : (i64) -> !fir.llvm_ptr<i8>
// CHECK:  fir.call @_FortranAAllocatableSetBaseAddr(%[[BW_BASE_REF]], %[[BW_BASE]])

// allocate(c%ptr, stat=s, errmsg=msg)
// CHECK:   %[[CP:.*]] = hlfir.designate %{{.*}}{"ptr"} fortran_attrs<pointer>
// CHECK:   fir.call @_QMprifPprif_allocate(%[[CP_SIZE:.*]], %[[CP_PTR:.*]], %[[CP_STAT:.*]], %[[CP_ERRMSG:.*]], %[[CP_NOERRMSG_ALLOC:.*]])
// CHECK:   %[[CP_STAT_VAL:.*]] = fir.load %[[CP_STAT]] : !fir.ref<i32>
// CHECK:   %[[CP_OK:.*]] = arith.cmpi eq, %[[CP_STAT_VAL]], %{{.*}} : i32
// CHECK:   cf.cond_br %[[CP_OK]], ^[[BB_OK:.*]], ^[[BB_JOIN:.*]]
// CHECK: ^[[BB_OK]]:
// CHECK:   %[[CP_ADDR_REF:.*]] = fir.coordinate_of %[[CP_PTR]], __address
// CHECK:   %[[CP_ADDR:.*]] = fir.load %[[CP_ADDR_REF]] : !fir.ref<i64>
// CHECK:   %[[CP_BASE_REF:.*]] = fir.convert %[[CP]] : {{.*}} -> !fir.ref<!fir.box<none>>
// CHECK:   %[[CP_BASE:.*]] = fir.convert %[[CP_ADDR]] : (i64) -> !fir.llvm_ptr<i8>
// CHECK:   fir.call @_FortranAAllocatableSetBaseAddr(%[[CP_BASE_REF]], %[[CP_BASE]])
// CHECK:   cf.br ^[[BB_JOIN]]
// CHECK: ^[[BB_JOIN]]:
// CHECK:   %[[CP_STAT_FINAL:.*]] = fir.load %[[CP_STAT]] : !fir.ref<i32>
// CHECK:   fir.store %[[CP_STAT_FINAL]] to %{{.*}} : !fir.ref<i32>


// deallocate(b%w, stat=s, errmsg=msg)
// CHECK:   fir.call @_QMprifPprif_deallocate({{.*}})

// deallocate(c%ptr)
// CHECK:   fir.call @_QMprifPprif_deallocate({{.*}})
