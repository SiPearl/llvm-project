; RUN: opt -S "-passes=loop(loop-simplifycfg),simplifycfg,dce" -verify-loop-info -verify-dom-info -verify-loop-lcssa < %s | FileCheck %s

target datalayout = "e-m:e-i64:64-f80:128-n8:16:32:64-S128-ni:1"

; A test for the simplest case: A stop-if-true PHI of type i1.
define i32 @test1(ptr %A, ptr %B) {
; CHECK-LABEL: define i32 @test1(
; CHECK-SAME: ptr [[A:%.*]], ptr [[B:%.*]]) {
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[LOOP_HEADER:%.*]]
; CHECK:       loop.header:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, [[ENTRY:%.*]] ], [ [[I_NEXT:%.*]], [[LOOP_HEADER]] ]
; CHECK-NEXT:    [[B_GEP:%.*]] = getelementptr inbounds i32, ptr [[B]], i64 [[I]]
; CHECK-NEXT:    [[B:%.*]] = load i32, ptr [[B_GEP]], align 4
; CHECK-NEXT:    [[A_GEP:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I]]
; CHECK-NEXT:    store i32 [[B]], ptr [[A_GEP]], align 4
; CHECK-NEXT:    [[CMP:%.*]] = icmp sgt i32 [[B]], 42
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[EXITCOND:%.*]] = icmp eq i64 [[I_NEXT]], 10
; CHECK-NEXT:    [[TMP0:%.*]] = or i1 [[EXITCOND]], [[CMP]]
; CHECK-NEXT:    br i1 [[TMP0]], label [[EXIT:%.*]], label [[LOOP_HEADER]]
; CHECK:       exit:
; CHECK-NEXT:    [[B_LAST_LCSSA:%.*]] = phi i32 [ [[B]], [[LOOP_HEADER]] ]
; CHECK-NEXT:    ret i32 [[B_LAST_LCSSA]]
;
entry:
  br label %loop.header

loop.header:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop.latch ]
  %done = phi i1 [ false, %entry ], [ %done.next, %loop.latch ]
  %b.prev = phi i32 [ -1, %entry ], [ %b.last, %loop.latch ]
  br i1 %done, label %loop.latch, label %if.then

if.then:
  %b.gep = getelementptr inbounds i32, ptr %B, i64 %i
  %b = load i32, ptr %b.gep, align 4
  %a.gep = getelementptr inbounds i32, ptr %A, i64 %i
  store i32 %b, ptr %a.gep, align 4
  %cmp = icmp sgt i32 %b, 42
  br label %loop.latch

loop.latch:
  %done.next = phi i1 [ %done, %loop.header ], [ %cmp, %if.then ]
  %b.last = phi i32 [ %b.prev, %loop.header ], [ %b, %if.then ]
  %i.next = add nuw nsw i64 %i, 1
  %exitcond = icmp eq i64 %i.next, 10
  br i1 %exitcond, label %exit, label %loop.header

exit:
  ret i32 %b.last
}

; A test where the loop must continue as long as the PHI of type i1 is true.
